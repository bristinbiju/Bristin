{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/fr", "destination": "/fr/index.html" },
    { "source": "/work/:slug", "destination": "/work/:slug.html" },
    { "source": "/fr/work/:slug", "destination": "/fr/work/:slug.html" }
  ],
  "headers": [
    {
      "source": "/(assets|images|og)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
